{
  "expo": {
    "name": "Nordi",
    "slug": "nordi-remitwave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/confirmed.png",
    "scheme": "nordiremitwave",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/confirmed.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/confirmed.png",
        "backgroundColor": "#020617"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.AccessBank",
      "splash": {
        "image": "./assets/images/confirmed.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./assets/images/confirmed.png",
          "backgroundColor": "#020617"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/images/confirmed.png"
      },
      "splash": {
        "image": "./assets/images/confirmed.png",
        "resizeMode": "contain",
        "dark": {
          "image": "./assets/images/confirmed.png",
          "backgroundColor": "#020617"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.AccessBank",
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/confirmed.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/confirmed.png",
            "backgroundColor": "#020617"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for security verification, fraud prevention, and regional remittance compliance.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location for security verification, fraud prevention, and regional remittance compliance."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan QR codes for payments and capture identity verification documents (KYC)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload identity verification documents and profile pictures."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID for secure biometric login and transaction authorization."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}